# ====================== 构建参数 ======================
ARG BUILDPLATFORM
ARG TARGETPLATFORM
ARG PYTHON_VERSION=3.10.14

# ====================== Builder 阶段（编译 Python 3.10） ======================
FROM --platform=${BUILDPLATFORM} ubuntu:18.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive
ARG PYTHON_VERSION

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    curl \
    wget \
    make \
    xz-utils \
    zlib1g-dev \
    libssl-dev \
    libffi-dev \
    libbz2-dev \
    libreadline-dev \
    libsqlite3-dev \
    liblzma-dev \
    libncurses5-dev \
    libncursesw5-dev \
    libgdbm-dev \
    libgdbm-compat-dev \
    libnss3-dev \
    uuid-dev \
    tk-dev \
    libexpat1-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /tmp

COPY Python-3.10.14.tgz /tmp/

RUN tar -xzf Python-${PYTHON_VERSION}.tgz

WORKDIR /tmp/Python-3.10.14

RUN ./configure --prefix=/opt/python3.10

RUN make -j2

RUN make install

RUN /opt/python3.10/bin/python3.10 -m ensurepip --upgrade

RUN /opt/python3.10/bin/python3.10 -m pip install --upgrade pip setuptools wheel

RUN /opt/python3.10/bin/python3.10 -m pip config set global.index-url http://repo.pe2.cc/repository/pypi/simple \
    && /opt/python3.10/bin/python3.10 -m pip config set global.trusted-host repo.pe2.cc

# ====================== 最终基础镜像 ======================
FROM --platform=${TARGETPLATFORM} ubuntu:18.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    bash \
    curl \
    gcc \
    g++ \
    make \
    locales \
    tzdata \
    telnet \
    netcat-openbsd \
    iputils-ping \
    gosu \
    vim \
    libgomp1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
    libjpeg-turbo8 \
    libpng16-16 \
    libssl1.1 \
    zlib1g \
    libbz2-1.0 \
    libreadline7 \
    libsqlite3-0 \
    liblzma5 \
    libncurses5 \
    libffi6 \
    libgdbm5 \
    libnss3 \
    libexpat1 \
    && sed -i 's/# zh_CN.UTF-8 UTF-8/zh_CN.UTF-8 UTF-8/g' /etc/locale.gen \
    && locale-gen zh_CN.UTF-8 \
    && update-locale LANG=zh_CN.UTF-8 \
    && echo "LC_ALL=zh_CN.UTF-8" >> /etc/environment \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /opt/python3.10 /opt/python3.10
COPY --from=builder /root/.config/pip/pip.conf /root/.config/pip/pip.conf

RUN ln -sf /opt/python3.10/bin/python3.10 /usr/bin/python3 \
    && ln -sf /opt/python3.10/bin/python3.10 /usr/bin/python \
    && ln -sf /opt/python3.10/bin/pip3.10 /usr/bin/pip3 \
    && ln -sf /opt/python3.10/bin/pip3.10 /usr/bin/pip

ENV PATH=/opt/python3.10/bin:$PATH \
    LANG=zh_CN.UTF-8 \
    LC_ALL=zh_CN.UTF-8 \
    TZ=UTC

WORKDIR /app

CMD ["bash"]
