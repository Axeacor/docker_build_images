# ====================== 构建参数 ======================
ARG BUILDPLATFORM
ARG TARGETPLATFORM

# ====================== Builder 阶段（用于配置 pip） ======================
FROM --platform=${BUILDPLATFORM} ubuntu:18.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    software-properties-common \
    ca-certificates \
    curl \
    && add-apt-repository ppa:deadsnakes/ppa \
    && apt-get update && apt-get install -y --no-install-recommends \
    python3.10 \
    python3.10-dev \
    python3.10-distutils \
    curl \
    && curl -sS https://bootstrap.pypa.io/get-pip.py -o /tmp/get-pip.py \
    && python3.10 /tmp/get-pip.py \
    && python3.10 -m pip install --upgrade pip \
    && python3.10 -m pip config set global.index-url http://repo.pe2.cc/repository/pypi/simple \
    && python3.10 -m pip config set global.trusted-host repo.pe2.cc \
    && rm -rf /var/lib/apt/lists/* /tmp/get-pip.py

# ====================== 最终基础镜像 ======================
FROM --platform=${TARGETPLATFORM} ubuntu:18.04

ENV DEBIAN_FRONTEND=noninteractive

# 系统运行时依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
    software-properties-common \
    ca-certificates \
    curl \
    bash \
    gcc \
    g++ \
    make \
    locales \
    tzdata \
    telnet \
    netcat-openbsd \
    iputils-ping \
    gosu \
    vim \
    libgomp1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
    libjpeg-turbo8 \
    libpng16-16 \
    && add-apt-repository ppa:deadsnakes/ppa \
    && apt-get update && apt-get install -y --no-install-recommends \
    python3.10 \
    python3.10-dev \
    python3.10-distutils \
    && curl -sS https://bootstrap.pypa.io/get-pip.py -o /tmp/get-pip.py \
    && python3.10 /tmp/get-pip.py \
    && ln -sf /usr/bin/python3.10 /usr/bin/python3 \
    && ln -sf /usr/bin/python3.10 /usr/bin/python \
    && ln -sf /usr/local/bin/pip /usr/bin/pip3 \
    && sed -i 's/# zh_CN.UTF-8 UTF-8/zh_CN.UTF-8 UTF-8/g' /etc/locale.gen \
    && locale-gen zh_CN.UTF-8 \
    && update-locale LANG=zh_CN.UTF-8 \
    && echo "LC_ALL=zh_CN.UTF-8" >> /etc/environment \
    && rm -rf /var/lib/apt/lists/* /tmp/get-pip.py

# 环境变量
ENV LANG=zh_CN.UTF-8 \
    LC_ALL=zh_CN.UTF-8 \
    TZ=UTC

# 复制 pip 配置
COPY --from=builder /root/.config/pip/pip.conf /root/.config/pip/pip.conf

# 设置工作目录
WORKDIR /app

CMD ["bash"]
