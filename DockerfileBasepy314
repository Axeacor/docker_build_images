# ====================== 构建参数 ======================
ARG BUILDPLATFORM
ARG TARGETPLATFORM
ARG PYTHON_VERSION=3.14.0

# ====================== Builder 阶段（编译 Python + 配置 pip） ======================
FROM --platform=${BUILDPLATFORM} ubuntu:18.04 AS builder

ARG PYTHON_VERSION

# Ubuntu 18.04 已 EOL，重写源到 old-releases
RUN printf "deb http://old-releases.ubuntu.com/ubuntu bionic main restricted universe multiverse\n\
deb http://old-releases.ubuntu.com/ubuntu bionic-updates main restricted universe multiverse\n\
deb http://old-releases.ubuntu.com/ubuntu bionic-security main restricted universe multiverse\n" > /etc/apt/sources.list && \
    printf 'Acquire::Check-Valid-Until "false";\n' > /etc/apt/apt.conf.d/99no-check-valid && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
    build-essential \
    wget \
    curl \
    gcc \
    g++ \
    gfortran \
    make \
    libssl-dev \
    zlib1g-dev \
    libbz2-dev \
    libreadline-dev \
    libsqlite3-dev \
    libncurses5-dev \
    libgdbm-dev \
    libnss3-dev \
    libffi-dev \
    liblzma-dev \
    tk-dev \
    uuid-dev \
    xz-utils \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# 编译安装 Python 3.14
RUN wget https://www.python.org/ftp/python/${PYTHON_VERSION}/Python-${PYTHON_VERSION}.tgz && \
    tar -xzf Python-${PYTHON_VERSION}.tgz && \
    cd Python-${PYTHON_VERSION} && \
    ./configure --prefix=/usr/local --enable-shared --with-ensurepip=install && \
    make -j"$(nproc)" && \
    make install && \
    ldconfig && \
    cd / && rm -rf Python-${PYTHON_VERSION} Python-${PYTHON_VERSION}.tgz

# 配置公司内部 PyPI 源
RUN /usr/local/bin/python3.14 -m pip install --upgrade pip && \
    /usr/local/bin/pip3.14 config set global.index-url http://repo.pe2.cc/repository/pypi/simple && \
    /usr/local/bin/pip3.14 config set global.trusted-host repo.pe2.cc

# ====================== 最终基础镜像 ======================
FROM --platform=${TARGETPLATFORM} ubuntu:18.04

ARG PYTHON_VERSION

# Ubuntu 18.04 已 EOL，重写源到 old-releases
RUN printf "deb http://old-releases.ubuntu.com/ubuntu bionic main restricted universe multiverse\n\
deb http://old-releases.ubuntu.com/ubuntu bionic-updates main restricted universe multiverse\n\
deb http://old-releases.ubuntu.com/ubuntu bionic-security main restricted universe multiverse\n" > /etc/apt/sources.list && \
    printf 'Acquire::Check-Valid-Until "false";\n' > /etc/apt/apt.conf.d/99no-check-valid && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
    libgomp1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
    libjpeg62-turbo \
    libpng16-16 \
    bash \
    curl \
    gcc \
    g++ \
    gfortran \
    ca-certificates \
    telnet \
    netcat-openbsd \
    iputils-ping \
    gosu \
    vim \
    locales \
    libssl1.1 \
    zlib1g \
    libbz2-1.0 \
    libreadline7 \
    libsqlite3-0 \
    libncurses5 \
    libgdbm5 \
    libnss3 \
    libffi6 \
    liblzma5 \
    tk \
    && rm -rf /var/lib/apt/lists/* \
    && sed -i 's/# zh_CN.UTF-8 UTF-8/zh_CN.UTF-8 UTF-8/g' /etc/locale.gen \
    && locale-gen zh_CN.UTF-8 \
    && update-locale LANG=zh_CN.UTF-8 \
    && echo "LC_ALL=zh_CN.UTF-8" >> /etc/environment

# 复制 Python
COPY --from=builder /usr/local /usr/local

# 创建软链接
RUN ldconfig && \
    ln -sf /usr/local/bin/python3.14 /usr/local/bin/python3 && \
    ln -sf /usr/local/bin/python3.14 /usr/local/bin/python && \
    ln -sf /usr/local/bin/pip3.14 /usr/local/bin/pip3 && \
    ln -sf /usr/local/bin/pip3.14 /usr/local/bin/pip && \
    mkdir -p /output

# 环境变量
ENV LANG=zh_CN.UTF-8 \
    LC_ALL=zh_CN.UTF-8 \
    TZ=UTC \
    PATH="/usr/local/bin:${PATH}" \
    LD_LIBRARY_PATH="/usr/local/lib:${LD_LIBRARY_PATH}"

# 复制 pip 配置
COPY --from=builder /root/.config/pip/pip.conf /root/.config/pip/pip.conf

# 设置工作目录
WORKDIR /app

CMD ["bash"]
