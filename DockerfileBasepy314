# ====================== 构建参数 ======================
ARG PYTHON_VERSION=3.14.0

# ====================== Builder 阶段（在 Ubuntu 18.04 上编译 Python） ======================
FROM ubuntu:18.04 AS builder

ARG PYTHON_VERSION

# 使用仍可用的归档源（清华镜像）
RUN echo 'deb http://mirrors.tuna.tsinghua.edu.cn/ubuntu/ bionic main restricted universe multiverse' > /etc/apt/sources.list && \
    echo 'deb http://mirrors.tuna.tsinghua.edu.cn/ubuntu/ bionic-updates main restricted universe multiverse' >> /etc/apt/sources.list && \
    echo 'deb http://mirrors.tuna.tsinghua.edu.cn/ubuntu/ bionic-security main restricted universe multiverse' >> /etc/apt/sources.list && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
      build-essential \
      wget \
      curl \
      gcc \
      g++ \
      gfortran \
      make \
      xz-utils \
      ca-certificates \
      zlib1g-dev \
      libssl-dev \
      libbz2-dev \
      libreadline-dev \
      libsqlite3-dev \
      libffi-dev \
      liblzma-dev \
      libncurses5-dev \
      tk-dev \
      uuid-dev \
      pkg-config \
      libhdf5-dev && \
    rm -rf /var/lib/apt/lists/*

# 编译安装 Python 3.14
RUN wget https://www.python.org/ftp/python/${PYTHON_VERSION}/Python-${PYTHON_VERSION}.tgz && \
    tar -xzf Python-${PYTHON_VERSION}.tgz && \
    cd Python-${PYTHON_VERSION} && \
    ./configure --prefix=/usr/local --enable-shared --with-ensurepip=install && \
    make -j"$(nproc)" && \
    make install && \
    ldconfig && \
    cd / && rm -rf Python-${PYTHON_VERSION} Python-${PYTHON_VERSION}.tgz

# 配置 pip 源
RUN /usr/local/bin/python3.14 -m pip install --upgrade pip && \
    /usr/local/bin/pip3.14 config set global.index-url http://repo.pe2.cc/repository/pypi/simple && \
    /usr/local/bin/pip3.14 config set global.trusted-host repo.pe2.cc

# ====================== 最终基础镜像（同样 Ubuntu 18.04，GLIBC 2.27 兼容） ======================
FROM ubuntu:18.04

ARG PYTHON_VERSION

# 使用仍可用的归档源（清华镜像）
RUN echo 'deb http://mirrors.tuna.tsinghua.edu.cn/ubuntu/ bionic main restricted universe multiverse' > /etc/apt/sources.list && \
    echo 'deb http://mirrors.tuna.tsinghua.edu.cn/ubuntu/ bionic-updates main restricted universe multiverse' >> /etc/apt/sources.list && \
    echo 'deb http://mirrors.tuna.tsinghua.edu.cn/ubuntu/ bionic-security main restricted universe multiverse' >> /etc/apt/sources.list && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
      bash \
      curl \
      gcc \
      g++ \
      gfortran \
      make \
      wget \
      ca-certificates \
      locales \
      zlib1g \
      zlib1g-dev \
      libssl1.1 \
      libssl-dev \
      libbz2-1.0 \
      libbz2-dev \
      libreadline7 \
      libreadline-dev \
      libsqlite3-0 \
      libsqlite3-dev \
      libffi6 \
      libffi-dev \
      liblzma5 \
      liblzma-dev \
      libncurses5 \
      libncurses5-dev \
      libgomp1 \
      libhdf5-dev \
      pkg-config && \
    rm -rf /var/lib/apt/lists/*

# locale 配置
RUN sed -i 's/# zh_CN.UTF-8 UTF-8/zh_CN.UTF-8 UTF-8/g' /etc/locale.gen && \
    locale-gen zh_CN.UTF-8 && \
    update-locale LANG=zh_CN.UTF-8 && \
    echo 'LC_ALL=zh_CN.UTF-8' >> /etc/environment

# 复制 Python（在 Ubuntu 18.04 上编译的，GLIBC 兼容）
COPY --from=builder /usr/local /usr/local

# 创建软链接
RUN ldconfig && \
    ln -sf /usr/local/bin/python3.14 /usr/local/bin/python3 && \
    ln -sf /usr/local/bin/python3.14 /usr/local/bin/python && \
    ln -sf /usr/local/bin/pip3.14 /usr/local/bin/pip3 && \
    ln -sf /usr/local/bin/pip3.14 /usr/local/bin/pip

RUN mkdir -p /output

# 环境变量
ENV LANG=zh_CN.UTF-8 \
    LC_ALL=zh_CN.UTF-8 \
    TZ=UTC \
    PATH="/usr/local/bin:${PATH}" \
    LD_LIBRARY_PATH="/usr/local/lib"

# 复制 pip 配置
COPY --from=builder /root/.config/pip/pip.conf /root/.config/pip/pip.conf

WORKDIR /app

CMD ["bash"]
