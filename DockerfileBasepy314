# 直接用官方 Python 3.14 镜像，只用来下载/编译 wheel
ARG TARGETPLATFORM
FROM --platform=${TARGETPLATFORM} python:3.14-slim

# 安装编译依赖（万一某些包需要编译）
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    g++ \
    gfortran \
    libssl-dev \
    zlib1g-dev \
    libbz2-dev \
    libffi-dev \
    liblzma-dev \
    && rm -rf /var/lib/apt/lists/*

# 配置公司内部 PyPI 源
RUN pip install --upgrade pip && \
    pip config set global.index-url http://repo.pe2.cc/repository/pypi/simple && \
    pip config set global.trusted-host repo.pe2.cc

# 输出目录
RUN mkdir -p /output

WORKDIR /app

CMD ["bash"]
