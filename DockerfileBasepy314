# ====================== 构建参数 ======================
ARG BUILDPLATFORM
ARG TARGETPLATFORM
ARG PYTHON_VERSION=3.14.0

# ====================== Builder 阶段（编译 Python + 配置 pip） ======================
FROM --platform=${BUILDPLATFORM} ubuntu:18.04 AS builder

ARG PYTHON_VERSION

# 配置旧源
RUN printf '%s\n' \
    'deb http://old-releases.ubuntu.com/ubuntu bionic main restricted universe multiverse' \
    'deb http://old-releases.ubuntu.com/ubuntu bionic-updates main restricted universe multiverse' \
    'deb http://old-releases.ubuntu.com/ubuntu bionic-security main restricted universe multiverse' \
    > /etc/apt/sources.list

RUN printf '%s\n' \
    'Acquire::Check-Valid-Until "false";' \
    'Acquire::AllowInsecureRepositories "true";' \
    'Acquire::AllowDowngradeToInsecureRepositories "true";' \
    > /etc/apt/apt.conf.d/99no-check-valid

RUN apt-get update

RUN apt-get install -y --no-install-recommends \
      build-essential \
      wget \
      curl \
      gcc \
      g++ \
      gfortran \
      make \
      xz-utils \
      ca-certificates \
      zlib1g-dev \
      libssl-dev \
      libbz2-dev \
      libreadline-dev \
      libsqlite3-dev \
      libffi-dev \
      liblzma-dev \
      libncurses5-dev \
      tk-dev \
      uuid-dev

RUN rm -rf /var/lib/apt/lists/*

# 编译安装 Python 3.14
RUN wget https://www.python.org/ftp/python/${PYTHON_VERSION}/Python-${PYTHON_VERSION}.tgz && \
    tar -xzf Python-${PYTHON_VERSION}.tgz && \
    cd Python-${PYTHON_VERSION} && \
    ./configure --prefix=/usr/local --enable-shared --with-ensurepip=install && \
    make -j"$(nproc)" && \
    make install && \
    ldconfig && \
    cd / && rm -rf Python-${PYTHON_VERSION} Python-${PYTHON_VERSION}.tgz

# 配置 pip 源
RUN /usr/local/bin/python3.14 -m pip install --upgrade pip
RUN /usr/local/bin/pip3.14 config set global.index-url http://repo.pe2.cc/repository/pypi/simple
RUN /usr/local/bin/pip3.14 config set global.trusted-host repo.pe2.cc

# ====================== 最终基础镜像 ======================
FROM --platform=${TARGETPLATFORM} ubuntu:18.04

ARG PYTHON_VERSION

# 配置旧源
RUN printf '%s\n' \
    'deb http://old-releases.ubuntu.com/ubuntu bionic main restricted universe multiverse' \
    'deb http://old-releases.ubuntu.com/ubuntu bionic-updates main restricted universe multiverse' \
    'deb http://old-releases.ubuntu.com/ubuntu bionic-security main restricted universe multiverse' \
    > /etc/apt/sources.list

RUN printf '%s\n' \
    'Acquire::Check-Valid-Until "false";' \
    'Acquire::AllowInsecureRepositories "true";' \
    'Acquire::AllowDowngradeToInsecureRepositories "true";' \
    > /etc/apt/apt.conf.d/99no-check-valid

RUN apt-get update

RUN apt-get install -y --no-install-recommends \
      bash \
      curl \
      gcc \
      g++ \
      gfortran \
      wget \
      ca-certificates \
      locales \
      zlib1g \
      libssl1.1 \
      libbz2-1.0 \
      libreadline7 \
      libsqlite3-0 \
      libffi6 \
      liblzma5 \
      libncurses5 \
      libgomp1

RUN rm -rf /var/lib/apt/lists/*

# locale 单独处理，避免和 apt 混在一起不好排错
RUN sed -i 's/# zh_CN.UTF-8 UTF-8/zh_CN.UTF-8 UTF-8/g' /etc/locale.gen
RUN locale-gen zh_CN.UTF-8
RUN update-locale LANG=zh_CN.UTF-8
RUN echo 'LC_ALL=zh_CN.UTF-8' >> /etc/environment

# 复制 Python
COPY --from=builder /usr/local /usr/local

# 创建软链接
RUN ldconfig
RUN ln -sf /usr/local/bin/python3.14 /usr/local/bin/python3
RUN ln -sf /usr/local/bin/python3.14 /usr/local/bin/python
RUN ln -sf /usr/local/bin/pip3.14 /usr/local/bin/pip3
RUN ln -sf /usr/local/bin/pip3.14 /usr/local/bin/pip
RUN mkdir -p /output

# 环境变量
ENV LANG=zh_CN.UTF-8 \
    LC_ALL=zh_CN.UTF-8 \
    TZ=UTC \
    PATH="/usr/local/bin:${PATH}" \
    LD_LIBRARY_PATH="/usr/local/lib:${LD_LIBRARY_PATH}"

# 复制 pip 配置
COPY --from=builder /root/.config/pip/pip.conf /root/.config/pip/pip.conf

WORKDIR /app

CMD ["bash"]
