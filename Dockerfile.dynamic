ARG BASE_IMAGE=ubuntu:22.04
ARG RUNTIME_IMAGE=python:3.11-slim

FROM ${BASE_IMAGE} AS base

ARG INSTALL_PACKAGES=""

SHELL ["/bin/sh", "-c"]

RUN set -eux; \
    if command -v apt-get >/dev/null 2>&1; then \
      apt-get update; \
      apt-get install -y --no-install-recommends ca-certificates curl bash; \
      if [ -n "${INSTALL_PACKAGES}" ]; then \
        apt-get install -y --no-install-recommends ${INSTALL_PACKAGES}; \
      fi; \
      rm -rf /var/lib/apt/lists/*; \
    elif command -v apk >/dev/null 2>&1; then \
      apk add --no-cache ca-certificates curl bash; \
      if [ -n "${INSTALL_PACKAGES}" ]; then \
        apk add --no-cache ${INSTALL_PACKAGES}; \
      fi; \
    elif command -v dnf >/dev/null 2>&1; then \
      dnf install -y ca-certificates curl bash; \
      if [ -n "${INSTALL_PACKAGES}" ]; then \
        dnf install -y ${INSTALL_PACKAGES}; \
      fi; \
      dnf clean all; \
    elif command -v yum >/dev/null 2>&1; then \
      yum install -y ca-certificates curl bash; \
      if [ -n "${INSTALL_PACKAGES}" ]; then \
        yum install -y ${INSTALL_PACKAGES}; \
      fi; \
      yum clean all; \
    else \
      echo "Unsupported base image package manager"; \
      exit 1; \
    fi

FROM ${RUNTIME_IMAGE} AS runtime

ARG PYTHON_PACKAGES=""
ARG NODE_PACKAGES=""

SHELL ["/bin/sh", "-c"]

COPY --from=base / /

RUN set -eux; \
    if command -v python >/dev/null 2>&1; then python --version; fi; \
    if command -v python3 >/dev/null 2>&1; then python3 --version; fi; \
    if command -v node >/dev/null 2>&1; then node --version; fi; \
    if command -v npm >/dev/null 2>&1 && [ -n "${NODE_PACKAGES}" ]; then npm install -g ${NODE_PACKAGES}; fi; \
    if command -v pip >/dev/null 2>&1 && [ -n "${PYTHON_PACKAGES}" ]; then pip install --no-cache-dir ${PYTHON_PACKAGES}; fi; \
    if command -v pip3 >/dev/null 2>&1 && [ -n "${PYTHON_PACKAGES}" ]; then pip3 install --no-cache-dir ${PYTHON_PACKAGES}; fi

WORKDIR /workspace

CMD ["sh"]
