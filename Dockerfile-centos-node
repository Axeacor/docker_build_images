FROM centos:7.9.2009

ENV LANG=en_US.UTF-8 \
    LC_ALL=en_US.UTF-8 \
    NODE_HOME=/usr/local/node \
    PATH=/usr/local/node/bin:$PATH

# 安装依赖
RUN yum clean all && \
    yum makecache && \
    yum install -y \
        unzip \
        sudo \
        tar \
        pcre-devel \
        gcc \
        gcc-c++ \
        make \
        openssl \
        openssl-devel \
        pango.x86_64 \
        libXcomposite.x86_64 \
        libXcursor.x86_64 \
        libXdamage.x86_64 \
        libXext.x86_64 \
        libXi.x86_64 \
        libXtst.x86_64 \
        cups-libs.x86_64 \
        libXScrnSaver.x86_64 \
        libXrandr.x86_64 \
        GConf2.x86_64 \
        alsa-lib.x86_64 \
        atk.x86_64 \
        gtk3.x86_64 \
        ipa-gothic-fonts \
        xorg-x11-fonts-100dpi \
        xorg-x11-fonts-75dpi \
        xorg-x11-utils \
        xorg-x11-fonts-cyrillic \
        xorg-x11-fonts-Type1 \
        xorg-x11-fonts-misc && \
    yum clean all && \
    rm -rf /var/cache/yum

# 创建用户
RUN useradd -u 1088 -m -s /bin/bash envuser && \
    echo "envuser ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

# 创建目录
RUN mkdir -p /root/.fonts \
    /home/envuser/gw-report-engine-node/fonts_patch \
    /usr/local/node

# 拷贝 Node 安装包
COPY node-v10.13.0-linux-arm64.tar.gz /tmp/

# 安装 Node
RUN tar -xzf /tmp/node-v10.13.0-linux-arm64.tar.gz -C /usr/local && \
    mv /usr/local/node-v10.13.0-linux-arm64/* /usr/local/node/ && \
    rm -rf /tmp/node-v10.13.0-linux-arm64* && \
    chown -R envuser:envuser /home/envuser

WORKDIR /home/envuser

CMD ["/bin/bash"]
