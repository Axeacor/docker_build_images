ARG SOURCE_IMAGE=python:3.11-slim
FROM ${SOURCE_IMAGE}

ARG PYTHON_PACKAGES=""
ARG NODE_PACKAGES=""

SHELL ["/bin/sh", "-c"]

RUN set -eux; \
    if command -v python >/dev/null 2>&1; then python --version; fi; \
    if command -v python3 >/dev/null 2>&1; then python3 --version; fi; \
    if command -v node >/dev/null 2>&1; then node --version; fi; \
    if [ -n "${NODE_PACKAGES}" ] && command -v npm >/dev/null 2>&1; then \
      npm install -g ${NODE_PACKAGES}; \
    fi; \
    if [ -n "${PYTHON_PACKAGES}" ] && command -v pip >/dev/null 2>&1; then \
      pip install --no-cache-dir ${PYTHON_PACKAGES}; \
    elif [ -n "${PYTHON_PACKAGES}" ] && command -v pip3 >/dev/null 2>&1; then \
      pip3 install --no-cache-dir ${PYTHON_PACKAGES}; \
    else \
      echo "No pip found or no python packages requested, skip"; \
    fi

WORKDIR /workspace
