ARG SOURCE_IMAGE=python:3.12-slim
FROM ${SOURCE_IMAGE}

ARG SOURCE_IMAGE
ARG PACKAGE_PROFILE=auto
ARG INSTALL_PACKAGES=""
ARG PYTHON_PACKAGES=""
ARG NODE_PACKAGES=""

LABEL org.opencontainers.image.base.name="${SOURCE_IMAGE}"

SHELL ["/bin/sh", "-c"]

RUN set -eux; \
    normalize_list() { \
      printf '%s' "$1" | tr ',\r\n' '   ' | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' -e 's/[[:space:]][[:space:]]*/ /g'; \
    }; \
    detect_package_manager() { \
      if command -v apt-get >/dev/null 2>&1; then echo apt; \
      elif command -v apk >/dev/null 2>&1; then echo apk; \
      elif command -v dnf >/dev/null 2>&1; then echo dnf; \
      elif command -v microdnf >/dev/null 2>&1; then echo microdnf; \
      elif command -v yum >/dev/null 2>&1; then echo yum; \
      else echo none; fi; \
    }; \
    profile_packages() { \
      pm="$1"; \
      profile="$2"; \
      case "${pm}:${profile}" in \
        apt:none|apk:none|dnf:none|microdnf:none|yum:none) echo "" ;; \
        apt:runtime) echo "ca-certificates curl bash" ;; \
        apk:runtime) echo "ca-certificates curl bash" ;; \
        dnf:runtime|microdnf:runtime|yum:runtime) echo "ca-certificates curl bash" ;; \
        apt:node-build) echo "ca-certificates curl bash python3 make g++" ;; \
        apk:node-build) echo "ca-certificates curl bash python3 make g++" ;; \
        dnf:node-build|microdnf:node-build|yum:node-build) echo "ca-certificates curl bash python3 make gcc-c++" ;; \
        apt:python-build) echo "ca-certificates curl bash build-essential gcc g++ make pkg-config git libffi-dev libssl-dev zlib1g-dev libbz2-dev libreadline-dev libsqlite3-dev liblzma-dev tk-dev uuid-dev cargo rustc" ;; \
        apk:python-build) echo "ca-certificates curl bash build-base pkgconf git libffi-dev openssl-dev zlib-dev bzip2-dev readline-dev sqlite-dev xz-dev tk-dev linux-headers cargo rust" ;; \
        dnf:python-build|microdnf:python-build) echo "ca-certificates curl bash gcc gcc-c++ make pkgconf-pkg-config git libffi-devel openssl-devel zlib-devel bzip2-devel readline-devel sqlite-devel xz-devel tk-devel libuuid-devel cargo rust" ;; \
        yum:python-build) echo "ca-certificates curl bash gcc gcc-c++ make pkgconfig git libffi-devel openssl-devel zlib-devel bzip2-devel readline-devel sqlite-devel xz-devel tk-devel libuuid-devel" ;; \
        apt:python-node-build) echo "ca-certificates curl bash build-essential gcc g++ make pkg-config python3 git libffi-dev libssl-dev zlib1g-dev libbz2-dev libreadline-dev libsqlite3-dev liblzma-dev tk-dev uuid-dev cargo rustc" ;; \
        apk:python-node-build) echo "ca-certificates curl bash build-base python3 pkgconf git libffi-dev openssl-dev zlib-dev bzip2-dev readline-dev sqlite-dev xz-dev tk-dev linux-headers cargo rust" ;; \
        dnf:python-node-build|microdnf:python-node-build) echo "ca-certificates curl bash python3 gcc gcc-c++ make pkgconf-pkg-config git libffi-devel openssl-devel zlib-devel bzip2-devel readline-devel sqlite-devel xz-devel tk-devel libuuid-devel cargo rust" ;; \
        yum:python-node-build) echo "ca-certificates curl bash python3 gcc gcc-c++ make pkgconfig git libffi-devel openssl-devel zlib-devel bzip2-devel readline-devel sqlite-devel xz-devel tk-devel libuuid-devel" ;; \
        *) echo "Unsupported package profile '${profile}' for package manager '${pm}'" >&2; exit 1 ;; \
      esac; \
    }; \
    install_system_packages() { \
      pm="$1"; \
      packages="$2"; \
      if [ -z "$(printf '%s' "$packages" | tr -d '[:space:]')" ]; then return 0; fi; \
      case "$pm" in \
        apt) apt-get update; DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends $packages; rm -rf /var/lib/apt/lists/* ;; \
        apk) apk add --no-cache $packages ;; \
        dnf) dnf install -y $packages; dnf clean all ;; \
        microdnf) microdnf install -y $packages; microdnf clean all ;; \
        yum) yum install -y $packages; yum clean all ;; \
        none) echo "System packages requested, but no supported package manager was found" >&2; exit 1 ;; \
      esac; \
    }; \
    python_packages="$(normalize_list "${PYTHON_PACKAGES}")"; \
    node_packages="$(normalize_list "${NODE_PACKAGES}")"; \
    extra_packages="$(normalize_list "${INSTALL_PACKAGES}")"; \
    profile="${PACKAGE_PROFILE:-auto}"; \
    if [ "$profile" = "auto" ]; then \
      wants_python=0; \
      wants_node=0; \
      if [ -n "$python_packages" ] && { command -v pip >/dev/null 2>&1 || command -v pip3 >/dev/null 2>&1 || command -v python >/dev/null 2>&1 || command -v python3 >/dev/null 2>&1; }; then wants_python=1; fi; \
      if [ -n "$node_packages" ] && command -v npm >/dev/null 2>&1; then wants_node=1; fi; \
      if [ "$wants_python" = "1" ] && [ "$wants_node" = "1" ]; then profile="python-node-build"; \
      elif [ "$wants_python" = "1" ]; then profile="python-build"; \
      elif [ "$wants_node" = "1" ]; then profile="node-build"; \
      elif [ -n "$extra_packages" ]; then profile="runtime"; \
      else profile="none"; fi; \
    fi; \
    pm="$(detect_package_manager)"; \
    packages="$(profile_packages "$pm" "$profile")"; \
    install_system_packages "$pm" "${packages} ${extra_packages}"; \
    if command -v python >/dev/null 2>&1; then python --version; fi; \
    if command -v python3 >/dev/null 2>&1; then python3 --version; fi; \
    if command -v node >/dev/null 2>&1; then node --version; fi; \
    if [ -n "$node_packages" ]; then \
      if ! command -v npm >/dev/null 2>&1; then echo "node packages requested, but npm was not found" >&2; exit 1; fi; \
      npm install -g $node_packages; \
    fi; \
    if [ -n "$python_packages" ]; then \
      if command -v python >/dev/null 2>&1 && python -m pip --version >/dev/null 2>&1; then python -m pip install --no-cache-dir $python_packages; \
      elif command -v python3 >/dev/null 2>&1 && python3 -m pip --version >/dev/null 2>&1; then python3 -m pip install --no-cache-dir $python_packages; \
      elif command -v pip >/dev/null 2>&1; then pip install --no-cache-dir $python_packages; \
      elif command -v pip3 >/dev/null 2>&1; then pip3 install --no-cache-dir $python_packages; \
      else echo "python packages requested, but pip was not found" >&2; exit 1; fi; \
    fi

WORKDIR /workspace
CMD ["sh"]
